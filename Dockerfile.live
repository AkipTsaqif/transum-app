# syntax=docker/dockerfile:1
# Sidecar-only image: the Next.js app stays on Vercel. A prebuilt bundle is
# used so the runtime image needs no node_modules and no build toolchain.

FROM node:22-bookworm-slim AS build
WORKDIR /app

# tsx provides esbuild transitively, so the bundler needs no extra dependency.
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

COPY tsconfig.json ./
COPY utils ./utils
COPY live ./live
COPY scripts/build-live-server.mjs ./scripts/build-live-server.mjs
RUN node scripts/build-live-server.mjs

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    TJ_LIVE_PORT=8787 \
    TJ_LIVE_HOST=0.0.0.0

# Only the artefact and the route styles it reads at startup.
COPY --from=build /app/dist/live/server.mjs ./server.mjs
COPY data/gtfs/routes.json ./data/gtfs/routes.json

# The process needs no filesystem writes and holds no secrets of its own.
USER node
EXPOSE 8787

# Liveness only: this reports enabled/clients, not whether the upstream feed is
# currently delivering. An "enabled":false answer means every stream is a 503.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.TJ_LIVE_PORT||8787)+'/live/health').then(r=>r.json()).then(b=>process.exit(b.enabled?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.mjs"]
