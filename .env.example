# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# MapTiler basemap key: https://cloud.maptiler.com/account/keys/
# Restrict the key to your domain in the MapTiler dashboard.
# Without it the app falls back to the keyless MapLibre demo basemap.
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key

# Experimental live buses (frontend). Once the separate live service is
# configured, buses display by default in the Transjakarta view; no per-route
# activation needed. Public deployment still needs confirmed realtime reuse
# terms, and the MQTT->SSE listener is not part of this deployment.
NEXT_PUBLIC_LIVE_ENABLED=false
# Empty in production with a same-origin /live/ reverse proxy; local example:
NEXT_PUBLIC_LIVE_BASE_URL=http://127.0.0.1:8787

# Live sidecar (`npm run live` / `bun live`). It loads .env.local and .env
# itself; anything set in the shell still wins. Origin must match the page
# exactly (localhost vs 127.0.0.1 differ) and is required once enabled.
# On the VPS the container reads only TJ_LIVE_* from its own live.env, never
# this file, so app keys are not injected into it.
TJ_LIVE_ENABLED=false
TJ_LIVE_ALLOWED_ORIGIN=http://localhost:3000
# TJ_LIVE_PORT=8787
# Loopback by default; only the container image sets 0.0.0.0.
# TJ_LIVE_HOST=127.0.0.1
